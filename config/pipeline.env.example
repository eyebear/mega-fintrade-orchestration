# Mega Fintrade Orchestration Configuration Example
# Copy this file to config/pipeline.env and update the values for your local machine.
# Do not commit config/pipeline.env.

# ------------------------------------------------------------
# Local repository paths
# ------------------------------------------------------------
# Recommended layout:
#
# mega-fintrade/
#   mega-fintrade-orchestration/
#   mega-fintrade-quant-engine/
#   mega-fintrade-market-engine-cpp/
#   mega-fintrade-backend-java/
#   mega-fintrade-risk-monitor-dotnet/
#
# If all repositories are beside each other, these relative paths should work.

QUANT_ENGINE_DIR="../mega-fintrade-quant-engine"
MARKET_ENGINE_CPP_DIR="../mega-fintrade-market-engine-cpp"
BACKEND_JAVA_DIR="../mega-fintrade-backend-java"
RISK_MONITOR_DOTNET_DIR="../mega-fintrade-risk-monitor-dotnet"

# ------------------------------------------------------------
# Java backend service
# ------------------------------------------------------------
# Project 1: mega-fintrade-backend-java
# Default Spring Boot local port is 8080.

JAVA_BACKEND_URL="http://localhost:8080"

# Import endpoint used by the orchestration pipeline.
JAVA_BACKEND_IMPORT_ENDPOINT="/api/import/all"

# Optional health endpoint.
# Update this later if the backend uses a different health endpoint.
JAVA_BACKEND_HEALTH_ENDPOINT="/actuator/health"

# ------------------------------------------------------------
# .NET risk monitor service
# ------------------------------------------------------------
# Project 4: mega-fintrade-risk-monitor-dotnet
# Your local .NET URL may be different depending on launch settings.

RISK_MONITOR_URL="http://localhost:5189"

# Dashboard URL printed after the pipeline finishes.
RISK_MONITOR_DASHBOARD_PATH="/dashboard"

# Optional monitor refresh endpoint.
# Update this later after the Project 4 refresh API is finalized.
RISK_MONITOR_REFRESH_ENDPOINT="/api/monitor/run"

# Optional health endpoint.
# Update this later if the .NET project uses a different health endpoint.
RISK_MONITOR_HEALTH_ENDPOINT="/health"

# ------------------------------------------------------------
# C++ market engine settings
# ------------------------------------------------------------
# Project 3: mega-fintrade-market-engine-cpp
# Supported values should match the C++ project behavior.
# Use "single" as the default safe option.

CPP_MODE="single"

# ------------------------------------------------------------
# Expected pipeline file names
# ------------------------------------------------------------
# Python Quant Engine -> C++ Market Engine

RAW_MARKET_DATA_FILE="raw_market_data.csv"

# C++ Market Engine -> Python Quant Engine

CLEANED_MARKET_DATA_FILE="cleaned_market_data.csv"
DAILY_RETURNS_FILE="daily_returns.csv"

# Python Quant Engine -> Java Backend

BACKTEST_RESULTS_FILE="backtest_results.csv"
RISK_METRICS_FILE="risk_metrics.csv"
STRATEGY_SIGNALS_FILE="strategy_signals.csv"
PORTFOLIO_EQUITY_CURVE_FILE="portfolio_equity_curve.csv"

# ------------------------------------------------------------
# Expected project-relative data paths
# ------------------------------------------------------------
# These paths are relative to each individual project repository.

QUANT_RAW_DATA_DIR="data/raw"
QUANT_PROCESSED_DATA_DIR="data/processed"
QUANT_OUTPUT_DATA_DIR="data/output"

CPP_INPUT_DATA_DIR="data/input"
CPP_OUTPUT_DATA_DIR="data/output"

JAVA_INPUT_DATA_DIR="data/input"

# ------------------------------------------------------------
# Future AI advisor settings
# ------------------------------------------------------------
# Project 5 is optional and disabled by default.
# The orchestration pipeline must skip AI steps when this is false.

AI_ADVISOR_ENABLED="false"
AI_ADVISOR_URL="http://localhost:7005"
AI_ADVISOR_REFRESH_ENDPOINT="/api/advisor/run"